        <mxCell id="25" value="PERTENCER&#xa;&#xa;[FOTO]&#xa;&#xa;Crescer é uma jornada partilhada.&#xa;[texto]" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#E7E5E4;fillColor=#FAF8F3;fontColor=#0F172A;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="2774" width="360" height="390" as="geometry"/></mxCell>
