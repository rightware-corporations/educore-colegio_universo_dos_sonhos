        <mxCell id="28" value="CONVITE&#xa;&#xa;[MARK / HALO]&#xa;Venha conhecer o COLUS.&#xa;&#xa;[Marcar visita]&#xa;Falar connosco →" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#FFF7ED;fontColor=#0F172A;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="3824" width="360" height="300" as="geometry"/></mxCell>
        <mxCell id="29" value="FOOTER&#xa;logo · contactos · redes · localização&#xa;&#xa;SEM PORTAL / LOGIN" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#081A2A;fillColor=#081A2A;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="4124" width="360" height="220" as="geometry"/></mxCell>
        <mxCell id="30" value="DECISÕES V0.3&#xa;&#xa;• Hero assimétrico / lower-left&#xa;• Header transparente → blur ao scroll&#xa;• 1 CTA principal no hero&#xa;• Manifesto maior e mais silencioso&#xa;• Descobrir + Criar fundidos num capítulo&#xa;• Tech como secção assinatura&#xa;• Vida COLUS media-led&#xa;• Closing sem depender de laranja sólido" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0C5898;fillColor=#EFF6FF;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1460" y="150" width="380" height="360" as="geometry"/></mxCell>
        <mxCell id="31" value="BRAND DEVICE MAP&#xa;&#xa;Hero → Light + radial subtil&#xa;Manifesto → Open Book curve&#xa;Aprender em Movimento → dots pontuais&#xa;Futuro &amp; Tecnologia → Light/Radial ALTO&#xa;Vida COLUS → quase nenhum&#xa;Pertencer → Open Book suave&#xa;Transformar → radial/expansão&#xa;Depoimentos → BAIXO&#xa;Closing → mark + light halo&#xa;Footer → logo completo" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#FFF7ED;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1460" y="540" width="380" height="390" as="geometry"/></mxCell>
        <mxCell id="32" value="RITMO&#xa;&#xa;CINEMATIC&#xa;→ QUIET EDITORIAL&#xa;→ INTERACTIVE STORY&#xa;→ DEEP IMMERSIVE&#xa;→ MEDIA-LED&#xa;→ HUMAN&#xa;→ ASPIRATIONAL&#xa;→ QUIET TRUST&#xa;→ STRONG CLOSE" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1460" y="960" width="380" height="300" as="geometry"/></mxCell>
        <mxCell id="33" value="PRÓXIMA REVISÃO&#xa;&#xa;1. tipografia de trabalho&#xa;2. direção exata do hero&#xa;3. proporções finais&#xa;4. seleção de media&#xa;5. storyboard de motion&#xa;&#xa;Ainda NÃO é high fidelity nem código." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1460" y="1290" width="380" height="260" as="geometry"/></mxCell>
        <mxCell id="34" value="PALETA PROVISÓRIA&#xa;&#xa;Orange observado: #F18136&#xa;Deep Blue observado: #0C5898&#xa;Bright Blue observado: #2899EF&#xa;&#xa;Confirmar com assets oficiais antes de produção." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#FFF7ED;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1460" y="1580" width="380" height="220" as="geometry"/></mxCell>
