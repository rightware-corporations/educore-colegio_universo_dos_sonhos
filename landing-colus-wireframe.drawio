        <mxCell id="22" value="APRENDER EM MOVIMENTO&#xa;&#xa;01 DESCOBRIR&#xa;[FOTO]&#xa;texto&#xa;&#xa;02 CRIAR&#xa;[MEDIA]&#xa;texto&#xa;&#xa;sem sticky no mobile" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#E2E8F0;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="1154" width="360" height="650" as="geometry"/></mxCell>
        <mxCell id="23" value="FUTURO &amp; TECNOLOGIA&#xa;&#xa;O futuro também se aprende.&#xa;&#xa;[TIC]&#xa;[ENGENHARIA]&#xa;[CIÊNCIA]&#xa;[SEGURANÇA DIGITAL]&#xa;&#xa;radial/light" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#0C5898;fillColor=#0C5898;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="1804" width="360" height="520" as="geometry"/></mxCell>
