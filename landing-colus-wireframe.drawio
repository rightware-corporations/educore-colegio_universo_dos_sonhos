        <mxCell id="7" value="HEADER&#xa;Logo COLUS | O Colégio | Experiência | Futuro | Comunidade | Contactos | [Marcar uma visita]" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="900" height="86" as="geometry"/></mxCell>
        <mxCell id="8" value="[VÍDEO / FOTO CINEMATOGRÁFICA FULL-BLEED]&#xa;&#xa;Juntos Tornamos Sonhos Em Realidade&#xa;&#xa;Uma experiência de aprendizagem que desperta curiosidade, confiança e visão de futuro.&#xa;&#xa;[Descobrir o COLUS]   [Marcar uma visita]&#xa;&#xa;↓ scroll" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#0A1B2A;fillColor=#0A1B2A;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="900" height="650" as="geometry"/></mxCell>
        <mxCell id="9" value="MANIFESTO — PROPÓSITO&#xa;&#xa;Aprender é descobrir o que somos capazes de transformar.&#xa;&#xa;[Texto editorial curto]&#xa;&#xa;                    [FOTO EDITORIAL 45%]" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#E2E8F0;fillColor=#F8F7F3;fontColor=#0F172A;fontSize=18;align=left;verticalAlign=middle;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="40" y="876" width="900" height="330" as="geometry"/></mxCell>
        <mxCell id="10" value="DESCOBRIR&#xa;&#xa;[GRANDE FOTO / VISITA / EXPERIÊNCIA]&#xa;&#xa;O conhecimento ganha vida quando a curiosidade encontra espaço para explorar.&#xa;&#xa;[2 imagens menores / legenda curta]" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#E2E8F0;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=18;align=left;verticalAlign=middle;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="40" y="1206" width="900" height="430" as="geometry"/></mxCell>
        <mxCell id="11" value="CRIAR&#xa;&#xa;[SEQUÊNCIA DE MEDIA: Engenharia · TIC · Arte · Dança · Línguas]&#xa;&#xa;Ciência, tecnologia, expressão e criatividade fazem parte da mesma jornada.&#xa;&#xa;[scroll horizontal / editorial]" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#D1D5DB;fillColor=#FFF7ED;fontColor=#0F172A;fontSize=18;align=left;verticalAlign=middle;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="40" y="1636" width="900" height="430" as="geometry"/></mxCell>
        <mxCell id="12" value="FUTURO &amp; TECNOLOGIA&#xa;&#xa;O futuro também se aprende.&#xa;&#xa;[TIC] [Engenharia] [Ciência] [Segurança Digital]&#xa;&#xa;[MEDIA PANELS + MOTION RADIAL DISCRETO]&#xa;&#xa;foco: mentalidade + competências + responsabilidade digital" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#0C5898;fillColor=#0C5898;fontColor=#FFFFFF;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2066" width="900" height="480" as="geometry"/></mxCell>
