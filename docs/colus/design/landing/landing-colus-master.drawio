        <mxCell id="intro_111" value="04 · 58–100%&#xa;&#xa;MOBILE HERO ASSEMBLY&#xa;&#xa;mark pequeno no header&#xa;headline em 3–4 linhas&#xa;1 CTA forte&#xa;CTA secundário textual&#xa;&#xa;nodes viram progress dots&#xa;ou desaparecem" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#071A2A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
