        <mxCell id="92" value="PRÓXIMA CENA — ESTADO 04 / HERO ASSEMBLY&#xa;&#xa;Depois de 55%: kicker + headline + CTA + header começam a montar-se.&#xa;O media já existe e a identidade já está distribuída pela interface." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#071A2A;fillColor=#071A2A;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;rotation=0;" vertex="1" parent="1"><mxGeometry x="40" y="2630" width="1720" height="120" as="geometry"/></mxCell>
