        <mxCell id="hero_96" value="78–92%&#xa;COPY + CTA&#xa;&#xa;supporting copy&#xa;[ Descobrir o COLUS ]&#xa;Marcar uma visita →" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#071A2A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="3090" width="300" height="210" as="geometry"/></mxCell>
