        <mxCell id="intro_69" value="BOOK GROUP&#xa;&#xa;01  mark original&#xa;02  páginas separam, crescem e rodam&#xa;03  deixam de parecer páginas pequenas e viram mask/portal&#xa;&#xa;A geometria é a transição." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0C5898;fillColor=#EFF6FF;fontColor=#0F172A;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;rotation=0;" vertex="1" parent="1"><mxGeometry x="460" y="1160" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="intro_70" value="LIGHT GROUP&#xa;&#xa;01  centro do mark&#xa;02  responde depois do livro&#xa;03  sobe e torna-se halo atmosférico&#xa;&#xa;Sem glow neon / cyberpunk." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#FFF4E8;fontColor=#0F172A;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;rotation=0;" vertex="1" parent="1"><mxGeometry x="880" y="1160" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="intro_71" value="RADIAL GROUP&#xa;&#xa;01  pertencem ao mark&#xa;02  ampliam o raio&#xa;03  4 nodes recebem função; restantes decoram, viram progress ou desaparecem&#xa;&#xa;Nada aleatório." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontColor=#0F172A;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;rotation=0;" vertex="1" parent="1"><mxGeometry x="1300" y="1160" width="460" height="210" as="geometry"/></mxCell>
