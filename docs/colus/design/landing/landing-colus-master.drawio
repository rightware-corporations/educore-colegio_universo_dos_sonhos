        <mxCell id="intro_112" value="[MARK]                         [☰]&#xa;&#xa;Juntos Tornamos&#xa;Sonhos Em&#xa;Realidade&#xa;&#xa;[ Descobrir o COLUS ]&#xa;Marcar visita →" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2899EF;fillColor=#173B52;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="1115" y="2155" width="270" height="205" as="geometry"/></mxCell>
        <mxCell id="intro_113" value="MOBILE SCROLL STAGE&#xa;&#xa;sticky stage aprox. 130–150svh&#xa;progress controlado por scroll nativo&#xa;sem bloquear gesto&#xa;sem parallax pesado&#xa;sem 4 labels orbitais simultâneas" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontColor=#0F172A;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1460" y="2120" width="300" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="intro_90" value="IMPLEMENTAÇÃO FUTURA&#xa;&#xa;React/TSX → estrutura + acessibilidade&#xa;SVG → BOOK / LIGHT / RADIAL / AXIS separados&#xa;Framer Motion → scroll progress + orchestration&#xa;CSS → mask / clip-path / gradients / transforms&#xa;Rive → só se o morph vetorial realmente justificar" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;rotation=0;" vertex="1" parent="1"><mxGeometry x="40" y="2440" width="540" height="250" as="geometry"/></mxCell>
        <mxCell id="intro_91" value="REDUCED MOTION&#xa;&#xa;Hero final montado diretamente.&#xa;Mark pequeno na posição final.&#xa;Fade curto.&#xa;Sem morph longo.&#xa;Mesmo conteúdo e navegação." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0C5898;fillColor=#EFF6FF;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;rotation=0;" vertex="1" parent="1"><mxGeometry x="610" y="2440" width="540" height="250" as="geometry"/></mxCell>
        <mxCell id="intro_92" value="PRÓXIMA CENA — ESTADO 04 / HERO ASSEMBLY&#xa;&#xa;Depois de 55%: kicker + headline + CTA + header começam a montar-se.&#xa;O media já existe e a identidade já está distribuída pela interface." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#071A2A;fillColor=#071A2A;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;rotation=0;" vertex="1" parent="1"><mxGeometry x="40" y="2750" width="1720" height="120" as="geometry"/></mxCell>
        <mxCell id="hero_92" value="ESTADO 04 — HERO ASSEMBLY / COREOGRAFIA DETALHADA" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#102231;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="3040" width="1050" height="30" as="geometry"/></mxCell>
        <mxCell id="hero_93" value="55–64%&#xa;AXIS → KICKER&#xa;&#xa;linha editorial nasce do eixo&#xa;COLÉGIO UNIVERSO DOS SONHOS" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0C5898;fillColor=#071A2A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="3090" width="300" height="210" as="geometry"/></mxCell>
