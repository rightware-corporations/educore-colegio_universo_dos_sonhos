        <mxCell id="life_70" value="MEDIA BEHAVIOR&#xa;&#xa;scale 1.00 → 1.03&#xa;crop shift&#xa;mask reveal curto&#xa;translate suave&#xa;crossfade quando necessário&#xa;&#xa;sem tilt 3D / zoom agressivo" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontColor=#102231;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="12130" width="430" height="280" as="geometry"/></mxCell>
        <mxCell id="life_71" value="BRAND INTENSITY&#xa;&#xa;LOW / MEDIUM-LOW&#xa;&#xa;Orange = markers&#xa;Blue = pontual&#xa;Book = memória de transição&#xa;Light = ausente&#xa;Logo = não repetir&#xa;&#xa;Fotografia é protagonista." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#FFF8EF;fontColor=#102231;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="12130" width="460" height="280" as="geometry"/></mxCell>
