        <mxCell id="2" value="COLUS — INTRO MORPH / SCROLL STORYBOARD V0.1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=21;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1000" height="34" as="geometry"/></mxCell>
        <mxCell id="3" value="Da marca para a experiência" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#64748B;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="500" height="24" as="geometry"/></mxCell>
        <mxCell id="4" value="REGRA: isto não é um splash de loading. É a própria primeira experiência da landing, controlada por scroll nativo." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#FFF7ED;fontColor=#9A3412;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="88" width="1710" height="54" as="geometry"/></mxCell>
        <mxCell id="5" value="00% — MARK ÍNTEGRO&#xa;&#xa;[MARK COLUS GRANDE]&#xa;&#xa;centrado&#xa;warm-white ou deep-blue&#xa;&#xa;micro breathing / halo&#xa;&#xa;sem hero convencional" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#FAF8F3;fontColor=#0F172A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="260" height="390" as="geometry"/></mxCell>
        <mxCell id="6" value="→" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#64748B;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="304" y="350" width="18" height="30" as="geometry"/></mxCell>
        <mxCell id="7" value="20% — LIVRO ABRE&#xa;&#xa;[BOOK GROUP]&#xa;← abre lateralmente →&#xa;&#xa;começa a virar&#xa;mask / curva / frame&#xa;&#xa;conhecimento abre espaço" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#FFF7ED;fontColor=#0F172A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="180" width="260" height="390" as="geometry"/></mxCell>
        <mxCell id="8" value="→" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#64748B;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="588" y="350" width="18" height="30" as="geometry"/></mxCell>
        <mxCell id="9" value="38% — LUZ SOBE&#xa;&#xa;[LIGHT GROUP]&#xa;↑ desloca / cresce&#xa;&#xa;halo aparece&#xa;&#xa;prepara a zona do media&#xa;&#xa;ideia → visão" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0C5898;fillColor=#0C5898;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="608" y="180" width="260" height="390" as="geometry"/></mxCell>
        <mxCell id="10" value="→" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#64748B;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="872" y="350" width="18" height="30" as="geometry"/></mxCell>
        <mxCell id="11" value="52% — RADIAIS SEPARAM&#xa;&#xa;•  •  •&#xa;   •  ○  •&#xa;•  •  •&#xa;&#xa;3–4 nodes funcionais&#xa;restantes decorativos&#xa;&#xa;Descobrir · Criar · Pertencer · Transformar" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0C5898;fillColor=#EFF6FF;fontColor=#0F172A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="892" y="180" width="260" height="390" as="geometry"/></mxCell>
        <mxCell id="12" value="→" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#64748B;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1156" y="350" width="18" height="30" as="geometry"/></mxCell>
        <mxCell id="13" value="68% — MEDIA REVEAL&#xa;&#xa;BOOK MASK abre&#xa;&#xa;[ VÍDEO / FOTO ]&#xa;&#xa;Light controla atmosfera&#xa;Book controla geometria&#xa;&#xa;não é simples fade" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#081A2A;fillColor=#081A2A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1176" y="180" width="260" height="390" as="geometry"/></mxCell>
        <mxCell id="14" value="→" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#64748B;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1440" y="350" width="18" height="30" as="geometry"/></mxCell>
        <mxCell id="15" value="100% — HERO MONTADO&#xa;&#xa;HEADER&#xa;&#xa;COLÉGIO UNIVERSO DOS SONHOS&#xa;&#xa;Juntos Tornamos&#xa;Sonhos Em Realidade&#xa;&#xa;[Descobrir]  Marcar visita →&#xa;&#xa;nodes nas posições finais" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#071A2A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1460" y="180" width="260" height="390" as="geometry"/></mxCell>
        <mxCell id="16" value="SCROLL BEHAVIOUR&#xa;&#xa;Stage pinned aprox. 160–220vh desktop.&#xa;O utilizador controla a velocidade.&#xa;Sem scroll-jacking.&#xa;Sem slides forçados.&#xa;Sem esperar animação terminar." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="540" height="220" as="geometry"/></mxCell>
        <mxCell id="17" value="PROGRESSIVE COMPOSITION&#xa;&#xa;Header completo só aparece perto do estado Hero.&#xa;CTA entra depois do contexto.&#xa;Nodes só ganham labels quando chegam ao destino.&#xa;Vídeo inicia apenas quando o reveal já começou." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0C5898;fillColor=#EFF6FF;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="610" width="540" height="220" as="geometry"/></mxCell>
        <mxCell id="18" value="REDUCED MOTION&#xa;&#xa;Mark já pequeno/final.&#xa;Hero montado diretamente.&#xa;Fade simples.&#xa;Sem morph longo.&#xa;Mesmo conteúdo e navegação." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#FFF7ED;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="610" width="570" height="220" as="geometry"/></mxCell>
        <mxCell id="19" value="MAPEAMENTO DOS COMPONENTES DA MARCA" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="700" height="28" as="geometry"/></mxCell>
        <mxCell id="20" value="BOOK" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="21" value="mask / abertura / transition" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="925" width="390" height="90" as="geometry"/></mxCell>
        <mxCell id="22" value="Conhecimento que se abre" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E7E5E4;fillColor=#FAF8F3;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="925" width="470" height="90" as="geometry"/></mxCell>
        <mxCell id="23" value="LIGHT" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1035" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="24" value="halo / spotlight / reveal atmosphere" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="1035" width="390" height="90" as="geometry"/></mxCell>
        <mxCell id="25" value="Ideia que ganha forma" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E7E5E4;fillColor=#FAF8F3;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="1035" width="470" height="90" as="geometry"/></mxCell>
        <mxCell id="26" value="RADIAL DOTS" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1145" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="27" value="nodes / progress / decoração" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="1145" width="390" height="90" as="geometry"/></mxCell>
        <mxCell id="28" value="Conhecimento que irradia" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E7E5E4;fillColor=#FAF8F3;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="1145" width="470" height="90" as="geometry"/></mxCell>
        <mxCell id="29" value="AXIS" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1255" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="30" value="story line / alinhamento / progress" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="1255" width="390" height="90" as="geometry"/></mxCell>
        <mxCell id="31" value="Ideia que se transforma em expressão" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E7E5E4;fillColor=#FAF8F3;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="1255" width="470" height="90" as="geometry"/></mxCell>
        <mxCell id="32" value="RADIAL NAV — PROPOSTA FUNCIONAL" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="880" width="570" height="28" as="geometry"/></mxCell>
        <mxCell id="33" value="● Descobrir&#xa;&#xa;● Criar&#xa;&#xa;● Pertencer&#xa;&#xa;● Transformar&#xa;&#xa;Desktop: labels surgem no hover/focus&#xa;Mobile: converter em progress dots ou remover" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0C5898;fillColor=#EFF6FF;fontColor=#0F172A;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="925" width="570" height="420" as="geometry"/></mxCell>
        <mxCell id="34" value="ARQUITETURA DE IMPLEMENTAÇÃO FUTURA" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1415" width="700" height="28" as="geometry"/></mxCell>
        <mxCell id="35" value="SVG GROUPS&#xa;&#xa;COLUS_MARK&#xa;├─ BOOK&#xa;├─ LIGHT&#xa;├─ RADIAL_GROUP&#xa;└─ AXIS" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1460" width="300" height="250" as="geometry"/></mxCell>
        <mxCell id="36" value="REACT / TSX&#xa;&#xa;estrutura&#xa;acessibilidade&#xa;estado&#xa;fallbacks&#xa;media lifecycle" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="1460" width="300" height="250" as="geometry"/></mxCell>
        <mxCell id="37" value="FRAMER MOTION&#xa;&#xa;scroll progress&#xa;transforms&#xa;opacity&#xa;orchestration&#xa;reduced motion" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0C5898;fillColor=#EFF6FF;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="1460" width="300" height="250" as="geometry"/></mxCell>
        <mxCell id="38" value="CSS / SVG&#xa;&#xa;mask / clip-path&#xa;gradients&#xa;layout&#xa;GPU-friendly transforms&#xa;responsive" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#FFF7ED;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="1460" width="300" height="250" as="geometry"/></mxCell>
        <mxCell id="39" value="RIVE — OPTIONAL&#xa;&#xa;avaliar só se o morph vetorial ficar demasiado complexo/reutilizável.&#xa;Não introduzir apenas por efeito." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E7E5E4;fillColor=#FAF8F3;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="1460" width="390" height="250" as="geometry"/></mxCell>
        <mxCell id="40" value="DECISÕES A FECHAR ANTES DE HIGH-FIDELITY&#xa;&#xa;1. Fundo inicial: warm-white ou deep-blue&#xa;2. Mark inteiro ou simplificado&#xa;3. Book Mask vs Light Reveal&#xa;4. 3 ou 4 radial nodes funcionais&#xa;5. vídeo vs fotografia&#xa;6. tipografia de trabalho" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F18136;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1760" width="820" height="250" as="geometry"/></mxCell>
        <mxCell id="41" value="PRINCÍPIO FINAL&#xa;&#xa;O objetivo não é “ter mais animações”.&#xa;&#xa;É fazer a identidade do COLUS tornar-se a própria arquitetura da interação." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#071A2A;fillColor=#071A2A;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="1760" width="850" height="250" as="geometry"/></mxCell>
